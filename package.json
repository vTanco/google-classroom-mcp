{
  "name": "google-classroom-mcp-docentes",
  "version": "3.1.0",
  "description": "Servidor MCP de Google Classroom para docentes: prepara tareas, materiales, temas y anuncios hablando con Claude. Instalación guiada y conexión desde el chat.",
  "type": "module",
  "bin": {
    "google-classroom-mcp-docentes": "dist/index.js",
    "google-classroom-mcp": "dist/index.js",
    "google-classroom-mcp-auth": "auth.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.js",
    "auth": "npm run build && node dist/index.js auth",
    "doctor": "npm run build && node dist/index.js doctor",
    "prepublishOnly": "npm test",
    "setup": "npm run build && node dist/index.js setup",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@googleapis/classroom": "^19.2.0",
    "@googleapis/drive": "^27.1.0",
    "@googleapis/slides": "^10.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.5.2"
  },
  "keywords": [
    "mcp",
    "google-classroom",
    "education",
    "ai",
    "model-context-protocol",
    "classroom-api"
  ],
  "license": "MIT",
  "author": "Vicente Tanco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vTanco/google-classroom-mcp.git"
  },
  "homepage": "https://github.com/vTanco/google-classroom-mcp#readme",
  "bugs": {
    "url": "https://github.com/vTanco/google-classroom-mcp/issues"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "auth.js",
    "README.md",
    "INSTALACION.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ]
}
